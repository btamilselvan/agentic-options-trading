# Copy to .env for local development. Never commit the real .env.
# Note the DOUBLE underscore in nested settings below (e.g. DATABASE__URL,
# LLM__PROVIDER) — that's pydantic-settings' nested-field delimiter, not a
# typo.

ENVIRONMENT=development

# Any SQLAlchemy-async URL works. Point this at your Supabase project's
# Postgres connection string (Session pooler / direct connection — get it
# from Supabase's Database Settings page) using the asyncpg driver:
#   postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres
# Schema is managed by Alembic (see "Database migrations" in README.md),
# not created by the app itself. Falls back to a local SQLite file below
# if unset, which is what the test suite always uses regardless of this
# value (tests never touch a real database).
DATABASE__URL=sqlite+aiosqlite:///./trading_app.db
DATABASE__ECHO=false

# Live trading is disabled by default and must be changed only through the
# protected /configuration/safety/live-mode action, never by editing this
# flag alone in a real deployment (requirements.md section 11).
SAFETY__DEFAULT_EXECUTION_MODE=PAPER
SAFETY__LIVE_TRADING_ENABLED=false
SAFETY__HUMAN_APPROVAL_ENABLED=true
SAFETY__KILL_SWITCH_ENGAGED=false

TELEGRAM__BOT_TOKEN=
TELEGRAM__ALLOWED_CHAT_IDS=[]
TELEGRAM__WEBHOOK_SECRET=

# Application code depends only on the InsightProvider interface
# (trading_app.services.insights), never a hardcoded provider/model name
# (requirements.md section 4.4). Switch providers by changing these two
# lines alone — no code change required:
#
#   LLM__PROVIDER=gemini, LLM__MODEL_NAME=gemini-2.5-flash   (needs GEMINI_API_KEY below)
#   LLM__PROVIDER=ollama, LLM__MODEL_NAME=llama3.1           (needs `ollama serve` running locally)
LLM__PROVIDER=gemini
LLM__MODEL_NAME=gemini-2.5-flash
LLM__OLLAMA_BASE_URL=http://localhost:11434
LLM__TIMEOUT_SECONDS=15
LLM__MAX_RETRIES=2
LLM__DAILY_SPEND_LIMIT_USD=5

SECRETS_BACKEND=env

# Secrets are resolved by trading_app.security.secrets, NOT nested under
# any of the settings groups above (requirements.md section 11) — set as
# plain top-level env vars.
GEMINI_API_KEY=

# Broker credentials — capability validation required before use
# (requirements.md sections 1, 4.6). Do not set these until validated.
# SCHWAB_CLIENT_ID=
# SCHWAB_CLIENT_SECRET=
# ROBINHOOD_API_KEY=
